# ══════════════════════════════════════════════════════
# .env.example — copia esto a .env y rellena los valores
# NUNCA cometas .env al repositorio
# ══════════════════════════════════════════════════════

# ─────── PostgreSQL ───────
POSTGRES_USER=erp_admin
POSTGRES_PASSWORD=           # genera con: openssl rand -base64 24
POSTGRES_DB=erp_saas_db

# ─────── Backend .NET ───────
DATABASE_URL=Host=postgres;Database=erp_saas_db;Username=erp_admin;Password=<POSTGRES_PASSWORD>
JWT_SECRET=                  # mínimo 64 chars: openssl rand -base64 64
JWT_ISSUER=Erp.Api
JWT_AUDIENCE=Erp.Client
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:5000

# ─────── Redis ───────
REDIS_URL=redis:6379

# ─────── Frontend ───────
NEXT_PUBLIC_API_URL=http://backend:5000
API_URL=http://backend:5000

# ─────── Domain ───────
DOMAIN=erp.tudominio.com

# ─────── Backup ───────
BACKUP_RETENTION_DAYS=30

# ─────── SII — Certificado FNMT-RCM ───────
# Coloca el .pfx en /opt/erp/certs/ en el servidor Hetzner
# y establece estos valores como CI/CD secrets (GitHub Actions → Settings → Secrets)
SII_CERT_PATH=/app/certs/fnmt.pfx
SII_CERT_PASS=               # contraseña del fichero .pfx
