# ══════════════════════════════════════════════════════
# .env.example — copia esto a .env y rellena los valores
# NUNCA cometas .env al repositorio
#
# Uso LOCAL (Docker Compose — override automático):
#   cp .env.example .env  (rellena POSTGRES_PASSWORD y JWT_SECRET)
#   docker compose up -d --build
#   Frontend: http://localhost (nginx) o http://localhost:3000 (directo)
#   Backend/Swagger: http://localhost:8081/swagger
#
# Uso PRODUCCIÓN (sin override de desarrollo):
#   docker compose -f docker-compose.yml -f docker-compose.prod.yml up -d --build
# ══════════════════════════════════════════════════════

# ─────── PostgreSQL ───────
POSTGRES_USER=erp_admin
POSTGRES_PASSWORD=           # genera con: openssl rand -base64 24
POSTGRES_DB=erp_saas_db
# Piloto RLS (ADR-0018 #34): en local el override fuerza true; en prod suele ser false
Postgres__RlsEnabled=true

# ─────── Backend .NET ───────
# La connection string se construye en docker-compose.yml a partir de los
# POSTGRES_* de arriba - no hace falta repetir la contraseña aquí.
JWT_SECRET=                  # mínimo 64 chars: openssl rand -base64 64
JWT_ISSUER=Erp.Api
JWT_AUDIENCE=Erp.Client
ASPNETCORE_ENVIRONMENT=Development
# Contraseña del admin semilla (también inyectada por docker-compose.override.yml).
Seed__AdminPassword=DevChangeMe2026!!
# 8080 coincide con ASPNETCORE_HTTP_PORTS del backend/Dockerfile y con el
# healthcheck (curl a localhost:8080/health/live) - no cambiar sin cambiar
# también el Dockerfile.
ASPNETCORE_URLS=http://+:8080

# ─────── Redis ───────
REDIS_URL=redis:6379

# ─────── Frontend ───────
# En local el backend se expone en 8081:8080, así que el navegador necesita
# esa URL; dentro de la red Docker el frontend llama al backend por nombre
# de servicio en el puerto 8080.
NEXT_PUBLIC_API_URL=http://localhost:8081
API_URL=http://backend:8080

# ─────── E2E Playwright (opcional — stack docker + credenciales seed) ───────
E2E_ADMIN_EMAIL=admin@devcorp.com
E2E_ADMIN_PASSWORD=DevChangeMe2026!!
# Usuario con 2FA activo para tests E2E (no incluido en seed docker por defecto):
# E2E_2FA_EMAIL=2fa@devcorp.com
# E2E_2FA_PASSWORD=DevChangeMe2026!!
# E2E_2FA_TOTP_SECRET=JBSWY3DPEHPK3PXP   # base32 del setup /api/auth/2fa/setup
# E2E_BACKEND_URL=http://localhost:8081
# Solo relevante para despliegue en servidor (nginx/TLS); en local no se usa.
DOMAIN=localhost

# ─────── Backup ───────
BACKUP_RETENTION_DAYS=30

# ─────── Stripe ───────
# En Development (local) el backend usa sk_test de appsettings.Development.json.
# En producción, rellenar con claves live reales (sk_live_, whsec_, pk_live_):
# Stripe__SecretKey=sk_live_...
# Stripe__WebhookSecret=whsec_...
# Stripe__PublishableKey=pk_live_...
# Stripe__PriceIds__Starter=price_...
# Stripe__PriceIds__Professional=price_...
# Stripe__PriceIds__Enterprise=price_...

# ─────── SII — Certificado FNMT-RCM ───────
# En local no hace falta: sin certificado, el backend arranca igual y solo
# quedan deshabilitadas las funciones de firma/envío SII. Si quieres probarlo
# en local, coloca el .pfx en ErpProject/deploy/certs/ (montado por
# docker-compose.override.yml). En servidor real, coloca el .pfx en /opt/erp/certs/.
SII_CERT_PATH=/app/certs/fnmt.pfx
SII_CERT_PASS=               # contraseña del fichero .pfx

# OpenTelemetry OTLP (docker compose local con otel-collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
